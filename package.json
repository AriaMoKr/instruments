    "url": "https://github.com/AriaMoKr/instruments/issues"
  },
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node node_modules/common/tools/vendor.mjs",
    "start": "node tools/serve.mjs",
    "test": "node --test \"test/*.test.js\"",
    "types": "tsc -p tsconfig.json && tsc -p tsconfig.strict.json",
    "preview": "node tools/preview.mjs"
  },
  "dependencies": {
    "common": "github:AriaMoKr/common#v0.7.1",
