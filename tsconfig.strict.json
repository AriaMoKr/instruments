{
  // The next step: the files that pass `strict`, a file at a time (tsconfig.json checks them all
  // without it). A file joins `include` when a change makes it pass; what it imports is checked
  // strictly with it. test/types.test.js runs it too.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true
  },
  "include": [
    "public/js/config.js", "public/js/presence.js", "public/js/room.js", "public/js/controls.js",
    "public/js/sound.js", "public/js/drums.js", "public/js/board.js", "public/js/midi.js",
    "public/js/clock.js", "public/js/pattern.js", "public/js/patch.js", "public/js/delay.js",
    "public/js/synth.js", "public/js/synthboard.js", "public/js/arp.js", "public/js/seq.js",
    "public/js/rackboard.js", "public/js/lfo.js",
    "types/*.d.ts"
  ]
}
